[Unit]
Description=zita-j2n: StemDeck's 10 channels to A3 Core (NUC)
PartOf=a3-main.service
After=a3-jack.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 2
# Address and port from the one truth (a3-osc.json): see tools/zita-from-truth.py.
ExecStart=/usr/bin/python3 %h/a3-system/stemdeck/tools/zita-from-truth.py j2n --chan 10 --24bit
CPUAffinity=1 2 3
# No real-time for the whole process: it put zita above JACK's own threads
# and made JACK report late clients. JACK raises zita's process thread.
# Fällt zita aus (es meldet dann trotzdem Status 0), kommt es nach 2 s
# wieder -- ohne Obergrenze, auch wenn das Netz eine Weile weg ist.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
