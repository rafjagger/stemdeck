[Unit]
Description=zita-n2j: 2 channels back from A3 Core (NUC)
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 2
# Port from the one truth (a3-osc.json): see tools/zita-from-truth.py.
ExecStart=/usr/bin/python3 %h/a3-system/stemdeck/tools/zita-from-truth.py n2j --chan 1-2 --buff 20 --info
CPUAffinity=1 2 3
CPUSchedulingPolicy=rr
CPUSchedulingPriority=64
# Fällt zita aus (es meldet dann trotzdem Status 0), kommt es nach 2 s
# wieder -- ohne Obergrenze, auch wenn das Netz eine Weile weg ist.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
